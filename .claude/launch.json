{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "play-molkky",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1"],
      "port": 8765
